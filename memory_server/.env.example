# Copy to .env and replace the tokens (e.g. with `openssl rand -hex 32`).
MEMORY_ADMIN_TOKEN=change-me-admin
# Read-only token for the web app (http://localhost:8080/).
MEMORY_VIEWER_TOKEN=change-me-viewer
# Comma-separated store=token pairs; an agent token only reaches its store.
MEMORY_AGENT_TOKENS=squashtm=change-me-agent
# Host port.
MEMORY_PORT=8080
