# Copy to .env and replace the tokens (e.g. with `openssl rand -hex 32`).
MEMORY_ADMIN_TOKEN=change-me-admin
# Read-only token for the web app (http://localhost:9501/).
MEMORY_VIEWER_TOKEN=change-me-viewer
# Comma-separated store=token pairs; an agent token only reaches its store.
MEMORY_AGENT_TOKENS=squashtm=change-me-agent
# Host port.
MEMORY_PORT=9501
# Model of semantic search, built into the image: english (default, about 220 MB of RAM), multilingual (also matches
# across languages, e.g. an English question and a French passage; about 700 MB of RAM), or none (no semantic search).
# After a change, rebuild: docker compose up -d --build
# MEMORY_EMBEDDING_MODEL=english
