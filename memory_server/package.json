{
  "name": "memory-server",
  "version": "0.1.0",
  "description": "Versioned document memory for LLM agents, exposed over REST and MCP",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "preact": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
