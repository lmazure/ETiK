# Copy to .env and replace the values.
# Token of the callers (the tester's ANALYST_TOKEN), e.g. `openssl rand -hex 32`.
ANALYST_TOKEN=change-me-analyst
# A READ-ONLY GitLab token: scopes read_api and read_repository only (e.g. a personal or group access token).
# The server refuses to start with a token having any other scope (api, write_repository...).
GITLAB_READ_TOKEN=change-me-read-only
# GitLab instance (default https://gitlab.com).
# GITLAB_URL=https://gitlab.com
# Subscription token of the analyses' Claude agent: run `claude setup-token` and paste it here.
# Without it, only the GitLab tools work.
CLAUDE_CODE_OAUTH_TOKEN=
# Model of the analyses (default opus).
# ANALYST_MODEL=opus
# A stored brief or investigation younger than this many hours, whose source has not changed, is returned at once
# instead of a new analysis (default 24; 0 never reuses).
# ANALYST_REUSE_HOURS=24
# Agent token of the memory store squashtm (MEMORY_AGENT_TOKENS of memory_server/.env), to store the analyses
# under /analyses/ and read the tester's issue reports.
MEMORY_AGENT_TOKEN=
# MEMORY_URL=http://host.docker.internal:9501
# Host port.
ANALYST_PORT=9502
