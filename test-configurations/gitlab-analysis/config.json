{
  "name": "SquashTM GitLab issue analysis",
  "systemPrompt": "system-prompt.md",
  "domains": [
    "gitlab.com"
  ],
  "hostPorts": [9501],
  "tools": {
    "builtin": "default",
    "mcpServers": {
      "memory": {
        "type": "http",
        "url": "${MEMORY_URL:-http://host.docker.internal:9501}/mcp",
        "headers": {
          "Authorization": "Bearer ${MEMORY_AGENT_TOKEN:-}",
          "X-Memory-Store": "squashtm"
        }
      }
    }
  },
  "env": ["MEMORY_URL", "MEMORY_AGENT_TOKEN", "GITLAB_READ_TOKEN"],
  "checks": [
    {
      "name": "memory server",
      "url": "${MEMORY_URL:-http://host.docker.internal:9501}/health"
    },
    {
      "name": "memory agent token",
      "url": "${MEMORY_URL:-http://host.docker.internal:9501}/api/stores/squashtm/list?depth=1&limit=1",
      "headers": { "Authorization": "Bearer ${MEMORY_AGENT_TOKEN}" }
    },
    {
      "name": "GitLab read token",
      "url": "https://gitlab.com/api/v4/projects/henixdevelopment%2Fsquash%2Fsquash-tm%2Fcore%2Fsquashtest-tm-staging",
      "headers": { "PRIVATE-TOKEN": "${GITLAB_READ_TOKEN}" }
    }
  ]
}
