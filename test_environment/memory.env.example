# Copy to memory.env (gitignored) and set the agent token of the memory store(s) of the configurations you run,
# i.e. the value after "<store>=" in MEMORY_AGENT_TOKENS of memory_server/.env
# (a token listed for several stores there reaches all of them).
# The container reads this file when it is created: run `docker compose up -d` again after a change.
# A configuration passes these variables on to Claude Code when it lists them in its "env" list.
MEMORY_AGENT_TOKEN=change-me-agent
# Memory server base URL, as seen from the container (the port must be in "hostPorts" of the configuration).
# MEMORY_URL=http://host.docker.internal:9501
