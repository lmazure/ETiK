# Copy to memory.env (gitignored) and set the agent token of the squashtm store,
# i.e. the value after "squashtm=" in MEMORY_AGENT_TOKENS of memory_server/.env.
# start-session.sh reads this file at each launch: no container rebuild is needed after a change.
MEMORY_AGENT_TOKEN=change-me-agent
# Memory server base URL, as seen from the dev container (the port must be allowed in .devcontainer/init-firewall.sh).
# MEMORY_URL=http://host.docker.internal:8080
# Memory store.
# MEMORY_STORE=squashtm
