# Copy to analyst.env (gitignored) and set the token of the analyst server, i.e. ANALYST_TOKEN of analyst_server/.env.
# It reaches the read-only GitLab tools of the analyst; the GitLab token itself stays in the analyst container.
# The container reads this file when it is created: run `docker compose up -d` again after a change.
# A configuration passes these variables on to Claude Code when it lists them in its "env" list.
ANALYST_TOKEN=change-me-analyst
# Analyst server base URL, as seen from the container (the port must be in "hostPorts" of the configuration).
# ANALYST_URL=http://host.docker.internal:9502
