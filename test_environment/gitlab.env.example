# Copy to gitlab.env (gitignored) to run a configuration that reads GitLab, e.g. test-configurations/gitlab-analysis.
# A READ-ONLY token: scopes read_api and read_repository only (e.g. a group access token, role Reporter).
# Never give a token with the api or write_repository scope: Claude Code runs unsupervised in this container.
# The container reads this file when it is created: run `docker compose up -d` again after a change.
# A configuration passes these variables on to Claude Code when it lists them in its "env" list.
GITLAB_READ_TOKEN=change-me-read-only
